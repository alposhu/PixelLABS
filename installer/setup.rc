#include <windows.h>
#include "resource.h"
#include "Version.h"

IDI_APP_ICON        ICON        "pixellabs.ico"
1                   RT_MANIFEST "setup.manifest"

// The built plugin, copied here by build.bat before the resource compiler runs.
IDR_PLUGIN_BINARY   RCDATA      "PixelLABS.vst3.bin"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    PIXELLABS_VERSION_MAJOR, PIXELLABS_VERSION_MINOR, PIXELLABS_VERSION_PATCH, 0
 PRODUCTVERSION PIXELLABS_VERSION_MAJOR, PIXELLABS_VERSION_MINOR, PIXELLABS_VERSION_PATCH, 0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      PIXELLABS_VENDOR
            VALUE "FileDescription",  "Pixel LABS VST3 Installer"
            VALUE "FileVersion",      PIXELLABS_VERSION_STR
            VALUE "InternalName",     "PixelLABS-Setup"
            VALUE "OriginalFilename", "PixelLABS-Setup.exe"
            VALUE "ProductName",      "Pixel LABS"
            VALUE "ProductVersion",   PIXELLABS_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
